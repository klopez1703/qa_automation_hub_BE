# Base de datos (SQLite para arrancar; en la nube usa una URL de Postgres)
DATABASE_URL="file:./dev.db"

# Firma de los JWT de sesión — cámbiala por un valor largo y aleatorio
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto del backend
PORT=4000

# Ruta ABSOLUTA a tu proyecto de automatización Playwright + Screenplay,
# el que hoy ejecutas con: npx playwright test tests/
PLAYWRIGHT_PROJECT_PATH="/ruta/absoluta/a/tu-proyecto-playwright"

# Dónde debe escribir este backend el Excel que tu proyecto Playwright
# espera leer (ajusta al nombre y ruta reales que usa tu proyecto)
EXCEL_OUTPUT_PATH="/ruta/absoluta/a/tu-proyecto-playwright/data/datos_prueba.xlsx"

# Carpeta donde este backend guarda logs de cada ejecución
LOGS_DIR="./logs"
